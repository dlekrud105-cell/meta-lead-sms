# Meta
META_VERIFY_TOKEN=my-secret-token-123
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxx

# AWS
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx

# SMS
MY_PHONE_NUMBER=+61412345678
SENDER_ID=LEADS

# Accounting dashboard (optional)
# Set a long random value to expose the read-only books at /accounting?token=...
# Leave it unset and the dashboard never mounts.
ACCOUNTING_TOKEN=
# Where the CSV books live. Defaults to ./data, which is ephemeral on most
# PaaS hosts - point this at a mounted volume if you run the dashboard there.
ACCOUNTING_DATA_DIR=
